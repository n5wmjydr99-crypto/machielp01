# Copiá a .env (o cargá estas variables en tu hosting). NUNCA subas .env a git.
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://tu-dominio.com.py     # URL pública exacta (la usan OAuth y Bancard)

# Dueños (obligatorio cambiar la clave antes de publicar)
ADMIN_USER=HOST
ADMIN_PASSWORD=cambiame-por-una-clave-larga

# Historial de demostración en las estadísticas (poné 0 en producción real)
SEED_DEMO=0

# Google: https://console.cloud.google.com → Credenciales → ID de cliente OAuth (Web)
#   URI de redirección autorizada: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: Sign in with Apple (necesita cuenta Apple Developer paga) → Services ID + clave .p8
#   Return URL: ${PUBLIC_URL}/api/auth/apple/callback  (Apple exige HTTPS y dominio verificado)
APPLE_CLIENT_ID=            # el Services ID, ej: py.com.nexustech.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=          # contenido del .p8 con los saltos de línea escritos como \n

# Bancard vPOS 2.0: te las entrega Bancard al abrir el comercio (primero en staging)
BANCARD_ENV=staging         # staging | production
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
#   URL de confirmación a registrar en Bancard: ${PUBLIC_URL}/api/bancard/confirm

# Sin claves de Bancard el pago es SIMULADO (solo fuera de producción, salvo ALLOW_MOCK_PAYMENTS=1)
# ALLOW_MOCK_PAYMENTS=1
